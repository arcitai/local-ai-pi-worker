#!/usr/bin/env bash
set -euo pipefail

worker_bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
worker_dir="${PI_WORKER_DATA_DIR:-$data_home/local-ai-pi-worker}"
worker_config="${PI_WORKER_CONFIG:-$config_home/local-ai-pi-worker/config.env}"

if [[ -r "$worker_config" ]]; then
  # shellcheck disable=SC1090
  source "$worker_config"
fi

provider="${PI_WORKER_PROVIDER:-${LOCAL_AI_PROVIDER_ID:-local-ai}}"
model="${PI_WORKER_MODEL:-${LOCAL_AI_MODEL_ID:-qwen3.8-27b-local}}"
thinking="${PI_WORKER_THINKING:-${LOCAL_AI_DEFAULT_REASONING:-medium}}"
tools="${PI_WORKER_TOOLS:-${PI_WORKER_DEFAULT_TOOLS:-read,grep,find,ls,web_search,web_fetch}}"
mode="${PI_WORKER_MODE:-text}"
result_json=0
rpc_mode=0
job_id="${PI_WORKER_JOB_ID:-piw-$(date -u +%s)-$$}"
pi_agent_dir="${PI_WORKER_PI_DIR:-$worker_dir/pi-agent}"
web_extension="${PI_WORKER_WEB_EXTENSION:-$pi_agent_dir/npm/node_modules/@tian.zuo/pi-web-search/index.ts}"
web_enabled=1
context_enabled=1
workdir=""
worker_skill="${PI_WORKER_CORE_SKILL:-$worker_dir/skills/bounded-worker}"
skill_paths=()
if [[ -e "$worker_skill" ]]; then
  skill_paths+=("$worker_skill")
fi
system_prompt_file="${PI_WORKER_SYSTEM_PROMPT_FILE:-$worker_dir/worker-system-prompt.txt}"
if [[ -n "${PI_WORKER_SYSTEM_PROMPT:-}" ]]; then
  system_prompt="$PI_WORKER_SYSTEM_PROMPT"
elif [[ -r "$system_prompt_file" ]]; then
  system_prompt="$(<"$system_prompt_file")"
else
  system_prompt='You are an isolated delegated worker. Complete only the bounded task and return a concise evidence-backed handoff to the lead. Do not ask the user, delegate further, leave the assigned working directory, or modify files without explicit write authorization.'
fi

usage() {
  printf '%s\n' \
    'Usage: pi-worker [options] [--] <task>' \
    '       <task on stdin> | pi-worker [options]' \
    '' \
    'Options:' \
    '  --provider NAME     Pi provider (default: configured local provider)' \
    '  --model ID          Model exposed by that provider' \
    '  --cwd PATH          Run the worker inside this explicit project root' \
    '  --job-id ID         Stable parent-owned worker identifier' \
    '  --thinking LEVEL    off|minimal|low|medium|high|xhigh|max' \
    '  --skill PATH        Add one explicit child skill (repeatable)' \
    '  --no-context-files  Ignore project AGENTS.md/CLAUDE.md files' \
    '  --tools LIST        Pi tool allowlist' \
    '  --no-tools          Disable every tool' \
    '  --no-web            Disable web_search and web_fetch' \
    '  --write             Enable scoped filesystem and shell mutation tools' \
    '  --json              Stream raw Pi JSONL events' \
    '  --result-json       Emit one stable final-result JSON object' \
    '  --rpc               Run a persistent Pi JSONL worker on stdin/stdout' \
    '  --text              Emit only final text' \
    '  --system-prompt TXT Override the minimal worker prompt' \
    '  --web-setup         Start Pi interactively; run /websearch-auth for Monid' \
    '  --sync              Force-refresh the worker catalog from the runtime' \
    '  --health            Synchronize and verify local worker readiness' \
    '  -h, --help          Show this help'
}

remove_tool() {
  local list=",$1,"
  local name="$2"
  list="${list//,$name,/,}"
  list="${list#,}"
  list="${list%,}"
  printf '%s' "$list"
}

while (($#)); do
  case "$1" in
    --provider)
      provider="${2:?missing value for --provider}"
      shift 2
      ;;
    --model)
      model="${2:?missing value for --model}"
      shift 2
      ;;
    --cwd)
      candidate="${2:?missing value for --cwd}"
      if [[ ! -d "$candidate" ]]; then
        printf 'pi-worker: working directory not found: %s\n' "$candidate" >&2
        exit 2
      fi
      workdir="$(cd -- "$candidate" && pwd -P)"
      shift 2
      ;;
    --job-id)
      job_id="${2:?missing value for --job-id}"
      shift 2
      ;;
    --thinking)
      thinking="${2:?missing value for --thinking}"
      shift 2
      ;;
    --tools)
      tools="${2:?missing value for --tools}"
      shift 2
      ;;
    --skill)
      candidate="${2:?missing value for --skill}"
      if [[ -d "$candidate" ]]; then
        skill_paths+=("$(cd -- "$candidate" && pwd -P)")
      elif [[ -f "$candidate" ]]; then
        skill_paths+=("$(cd -- "$(dirname -- "$candidate")" && pwd -P)/$(basename -- "$candidate")")
      else
        printf 'pi-worker: skill path not found: %s\n' "$candidate" >&2
        exit 2
      fi
      shift 2
      ;;
    --no-tools)
      tools=""
      web_enabled=0
      shift
      ;;
    --no-context-files)
      context_enabled=0
      shift
      ;;
    --no-web)
      web_enabled=0
      shift
      ;;
    --write)
      tools="read,bash,edit,write,grep,find,ls,web_search,web_fetch"
      shift
      ;;
    --json)
      mode="json"
      shift
      ;;
    --result-json)
      mode="text"
      result_json=1
      shift
      ;;
    --rpc)
      mode="rpc"
      rpc_mode=1
      shift
      ;;
    --text)
      mode="text"
      shift
      ;;
    --system-prompt)
      system_prompt="${2:?missing value for --system-prompt}"
      shift 2
      ;;
    --web-setup)
      export PI_CODING_AGENT_DIR="$pi_agent_dir"
      export PI_TELEMETRY=0 PI_SKIP_VERSION_CHECK=1 FIRECRAWL_KEYLESS=0
      unset FIRECRAWL_API_KEY
      exec pi --no-extensions --extension "$web_extension"
      ;;
    --sync)
      exec "$worker_bin_dir/pi-worker-sync"
      ;;
    --health)
      "$worker_bin_dir/pi-worker-sync" --ensure
      export PI_CODING_AGENT_DIR="$pi_agent_dir"
      exec pi --list-models "$provider"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'pi-worker: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ ! "$job_id" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]]; then
  printf 'pi-worker: --job-id must be 1-128 safe identifier characters\n' >&2
  exit 2
fi

if ((rpc_mode)) && { [[ "$mode" != rpc ]] || ((result_json)); }; then
  printf 'pi-worker: --rpc cannot be combined with --json, --result-json, or --text\n' >&2
  exit 2
fi

if ((rpc_mode)) && (($#)); then
  printf 'pi-worker: --rpc accepts commands on stdin, not an initial task argument\n' >&2
  exit 2
elif ((rpc_mode)); then
  task=""
elif (($#)); then
  task="$*"
elif [[ ! -t 0 ]]; then
  task="$(</dev/stdin)"
else
  printf 'pi-worker: provide a task as arguments or on stdin\n' >&2
  usage >&2
  exit 2
fi

if ((rpc_mode == 0)) && [[ -z "${task//[[:space:]]/}" ]]; then
  printf 'pi-worker: task must not be empty\n' >&2
  exit 2
fi

if [[ -n "$workdir" ]]; then
  cd -- "$workdir"
else
  workdir="$(pwd -P)"
fi

if [[ "$provider" == "${LOCAL_AI_PROVIDER_ID:-local-ai}" \
  && "$model" == "${LOCAL_AI_MODEL_ID:-qwen3.8-27b-local}" ]]; then
  "$worker_bin_dir/pi-worker-sync" --ensure --quiet
fi

if ((web_enabled)); then
  if [[ ! -f "$web_extension" ]]; then
    printf 'pi-worker: web extension not found: %s\n' "$web_extension" >&2
    exit 1
  fi
else
  tools="$(remove_tool "$tools" web_search)"
  tools="$(remove_tool "$tools" web_fetch)"
fi

export PI_CODING_AGENT_DIR="$pi_agent_dir"
export PI_TELEMETRY=0 PI_SKIP_VERSION_CHECK=1 FIRECRAWL_KEYLESS=0
unset FIRECRAWL_API_KEY

args=(
  --provider "$provider"
  --model "$model"
  --thinking "$thinking"
  --mode "$mode"
  --no-extensions
  --no-skills
  --no-prompt-templates
  --no-themes
  --offline
  --system-prompt "$system_prompt"
)

if ((context_enabled == 0)); then
  args+=(--no-context-files)
fi

for skill_path in "${skill_paths[@]}"; do
  args+=(--skill "$skill_path")
done

if ((rpc_mode == 0)); then
  args+=(--print --no-session)
else
  args+=(--name "$job_id")
fi

if ((web_enabled)); then
  args+=(--extension "$web_extension")
fi

if [[ -n "$tools" ]]; then
  args+=(--tools "$tools")
else
  args+=(--no-tools)
fi

if ((result_json)); then
  if result="$(pi "${args[@]}" "$task")"; then
    status=0
  else
    status=$?
  fi
  jq -n \
    --argjson ok "$([[ "$status" -eq 0 ]] && printf true || printf false)" \
    --argjson exit_code "$status" \
    --arg job_id "$job_id" \
    --arg state "$([[ "$status" -eq 0 ]] && printf settled || printf failed)" \
    --arg provider "$provider" \
    --arg model "$model" \
    --arg cwd "$workdir" \
    --arg result "$result" \
    '{ok:$ok, exit_code:$exit_code, job_id:$job_id, state:$state, provider:$provider, model:$model, cwd:$cwd, result:$result}'
  exit "$status"
fi

if ((rpc_mode)); then
  exec pi "${args[@]}"
fi

exec pi "${args[@]}" "$task"
