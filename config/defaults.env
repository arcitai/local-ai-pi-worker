# Versions are pinned so a reinstall has the same behavior. Override them in
# ~/.config/local-ai-pi-worker/config.env when testing a newer release.
PI_VERSION=0.84.3
PI_WEB_SEARCH_VERSION=0.4.0

LOCAL_AI_PROVIDER_ID=local-ai
LOCAL_AI_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL_ID=qwen3.8-27b-local
LOCAL_AI_MODEL_NAME="Qwen 3.8 27B Local"
LOCAL_AI_API=openai-completions
# Leave blank to preserve an existing matching provider key or discover the key
# from a running local llama-server process. Set it explicitly when the runtime
# uses another authentication mechanism.
LOCAL_AI_API_KEY=
# Leave blank to inherit the served context from the runtime's /v1/models
# metadata. Set only when a compatible runtime does not publish a context.
LOCAL_AI_CONTEXT_WINDOW_OVERRIDE=
LOCAL_AI_MAX_OUTPUT_TOKENS=8192
LOCAL_AI_DEFAULT_REASONING=medium
LOCAL_AI_THINKING_LEVELS=low,medium,xhigh

PI_WORKER_DEFAULT_PROFILE=inspect
# Blank installs the portable orchestration skill in $CODEX_HOME/skills (or
# ~/.codex/skills). Point this at another parent harness's global skill root
# when Codex is not the caller.
PI_WORKER_SKILL_ROOT=
# Blank lets child workers discover machine-global Agent Skills from
# ~/.agents/skills. This is separate from the parent orchestration skill root.
PI_WORKER_MACHINE_SKILL_ROOT=
# Stable GitHub release source. Override for a maintained fork.
PI_WORKER_UPDATE_REPO=gustavonline/local-ai-pi-worker
# A systemd user timer checks daily and notifies once per new release.
PI_WORKER_UPDATE_NOTIFY=1
