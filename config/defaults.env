# Versions are pinned so a reinstall has the same behavior. Override them in
# ~/.config/local-ai-pi-worker/config.env when testing a newer release.
OPENCODEX_VERSION=2.34.0
PI_VERSION=0.84.3
PI_WEB_SEARCH_VERSION=0.4.0

OPENCODEX_PORT=10100
LOCAL_AI_PROVIDER_ID=local-ai
LOCAL_AI_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL_ID=qwen3.8-27b-local
# Leave blank to preserve an existing OpenCodex provider key or discover the
# key from a running local llama-server process. Set it explicitly when the
# runtime uses another authentication mechanism.
LOCAL_AI_API_KEY=
LOCAL_AI_CONTEXT_WINDOW=65536
LOCAL_AI_MAX_OUTPUT_TOKENS=8192
LOCAL_AI_DEFAULT_REASONING=medium

PI_WEB_SEARCH_MODEL=gpt-5.6-luna
CODEX_WEB_SEARCH_MODEL=gpt-5.6-luna
CODEX_VISION_MODEL=gpt-5.6-luna
PI_WORKER_CLOUD_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol,gpt-5.4-mini
PI_WORKER_DEFAULT_TOOLS=read,grep,find,ls,web_search,web_fetch
