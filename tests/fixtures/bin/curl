#!/usr/bin/env bash
set -euo pipefail

printf 'CURL_ARGS=%s\n' "$*" >> "${MOCK_LOG:?}"
if [[ "${MOCK_CURL_FAIL:-0}" == 1 ]]; then
  exit 22
fi
if [[ "$*" == *'api.github.com/repos/'*'/releases/latest'* ]]; then
  latest="${MOCK_LATEST_VERSION:-v0.5.0}"
  printf '{"tag_name":"%s","html_url":"https://github.com/onlinesourdough/local-ai-pi-worker/releases/tag/%s"}\n' \
    "$latest" "$latest"
  exit 0
fi
if [[ "$*" == *'github.com/'*'/archive/refs/tags/'*'.tar.gz'* ]]; then
  output=""
  previous=""
  for argument in "$@"; do
    if [[ "$previous" == --output ]]; then
      output="$argument"
      break
    fi
    previous="$argument"
  done
  [[ -n "$output" && -r "${MOCK_RELEASE_TARBALL:-}" ]] || exit 22
  cp -- "$MOCK_RELEASE_TARBALL" "$output"
  exit 0
fi
context="${MOCK_RUNTIME_CONTEXT:-131072}"
printf '{"data":[{"id":"qwen3.8-27b-local","meta":{"n_ctx":%s}}]}\n' "$context"
